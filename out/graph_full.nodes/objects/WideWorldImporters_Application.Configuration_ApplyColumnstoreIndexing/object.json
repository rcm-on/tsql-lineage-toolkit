            "N' CREATE NONCLUSTERED COLUMNSTORE INDEX NCCX_Sales_InvoiceLines ON Sales.InvoiceLines (     InvoiceID,     StockItemID,     Quantity,     UnitPrice,     LineProfit,     LastEditedWhen )'",
