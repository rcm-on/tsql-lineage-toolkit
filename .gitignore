# Archivos de configuración de usuario y de IDE
*.user
*.userosscache
*.sln.docstates
*.suo
.vs/

# Artefactos de build de .NET
[Bb]in/
[Oo]bj/

# Dependencias de Node.js
node_modules/
dashboard/e2e/node_modules/

# Ficheros de salida del analizador y del pipeline
# Estos directorios contienen los NodeStores y grafos generados, que son pesados y se pueden reproducir.
out/
eval/*/out/
eval/*/graph_full.nodes/

# Ficheros intermedios generados durante el pipeline
input.json
graph_full.json
*.nodes/

# Corpus de evaluación externos que no deben subirse
# El README indica que se deben copiar manualmente.
eval/sqlglot-validator/corpus/lineage.json

# Logs y reportes de tests
logs/
*.log
npm-debug.log*
playwright-report/
test-results/

# Ficheros generados por el sistema operativo
.DS_Store
Thumbs.db